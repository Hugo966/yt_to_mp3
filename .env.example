# Backend API URL
# For local development
VITE_API_URL=http://localhost:8000

# For production, update this to your deployed backend URL
# VITE_API_URL=https://your-backend-url.com

# Supabase project. Find these under Project Settings > API in the dashboard.
# Note that VITE_ variables are inlined into the client bundle at build time,
# so only ever put the publishable (anon) key here, never the service role key.
VITE_SUPABASE_PROJECT_ID=your-project-ref
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-anon-key
